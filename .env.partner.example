# TPA코리아용 — 이맥스 자체 서버(114.203.209.5, Windows, G:\MESSAGE)
# ※ Docker 미사용 — Node.js·PostgreSQL 직접 설치. 운영 정보: docs/TPAKOREA-SERVER.md
# 복사: copy .env.partner.example packages\server\.env  (서버가 packages\server 에서 실행되며 그 폴더의 .env를 읽음)
# 클라이언트 접속 URL: https://msg.tpakorea-gw.co.kr:3443 (Caddy → 3001, docs/HTTPS-TPAKOREA.md)
# 비밀값(JWT_SECRET, DB/MSSQL 비밀번호)은 서버 .env에만 입력하고 저장소에 커밋하지 말 것
# LDAP 미사용 거래처 — 아래 LDAP_* 블록은 그대로 주석 유지

# PostgreSQL 직접 설치 (localhost:5432)
DATABASE_URL="postgresql://message:<비밀번호>@localhost:5432/message"
PORT=3001

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@admin.com

PARTNER_ORG_SOURCE=mssql
PARTNER_COMPANY_NAME=TPA
PARTNER_COMPANY_EXTERNAL_CODE=TPA
# TPA는 EPS ERP 계열(HRA100/HRA150/HRA200) 스키마 — CSIN과 테이블 구조가 완전히 다름
PARTNER_MSSQL_SCHEMA=tpa_eps
# HRA200/HRA100의 사업장코드(bs_cd) — TPA코리아 조직은 A01로 확인됨
PARTNER_TPA_BS_CD=A01
# HRA150.email이 비어있는 재직자가 많아(55명 중 2명만 있음), 없으면 emp_no 기반으로
# 로그인용 가상 이메일을 만든다 (예: 00001@tpakorea.local)
PARTNER_SYNTHETIC_EMAIL_DOMAIN=tpakorea.local
# 메신저 서버와 DB가 같은 호스트(114.203.209.5)라 localhost로 바로 접속
PARTNER_MSSQL_SERVER=localhost
PARTNER_MSSQL_PORT=1433
PARTNER_MSSQL_DATABASE=System8_TPA
PARTNER_MSSQL_USER=sa
PARTNER_MSSQL_PASSWORD=
PARTNER_MSSQL_ENCRYPT=false
PARTNER_MSSQL_TRUST_CERT=true
PARTNER_DEFAULT_PASSWORD=123456

# 이 거래처는 LDAP 미사용 — 아래 블록 전부 비활성 상태 유지
# LDAP_ENABLED=true
# LDAP_URL=ldaps://ldap.csin.kr:636
# LDAP_BASE_DN=dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_BASE=cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_FILTER=(&(objectClass=posixAccount)(uid=%s)(!(shadowExpire=1)))
# LDAP_BIND_DN=uid=ldap_gw,cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_BIND_PASSWORD=
# LDAP_EMAIL_DOMAIN=csin.kr
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_LOCAL_EXCEPTIONS=
